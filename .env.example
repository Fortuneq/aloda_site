# Environment variables for ALODA Docker deployment
# Copy this file to .env and update with your values

# Domain configuration
DOMAIN=your-domain.com
WWW_DOMAIN=www.your-domain.com
EMAIL=your-email@domain.com

# Nginx configuration
NGINX_HOST=localhost
NGINX_PORT=80
SSL_PORT=443

# SSL configuration
SSL_EMAIL=your-email@domain.com
CERTBOT_EMAIL=your-email@domain.com

# Security settings
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';"

# Monitoring (optional)
ENABLE_MONITORING=false
WATCHTOWER_INTERVAL=3600

# Backup settings
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/home/user/backups